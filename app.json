{
  "expo": {
    "name": "Kettleborn",
    "slug": "kettleborn",
    "scheme": "kettleborn",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0908",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0908",
          "image": "./assets/images/splash.png",
          "resizeMode": "cover"
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kettleborn.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1C1917"
      },
      "package": "com.kettleborn.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "name": "Kettleborn",
      "shortName": "Kettleborn",
      "lang": "en",
      "display": "standalone",
      "startUrl": ".",
      "scope": ".",
      "themeColor": "#0A0908",
      "backgroundColor": "#0A0908"
    }
  }
}
